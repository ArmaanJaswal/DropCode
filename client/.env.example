# ========================================================
# PeerShare Frontend Environment Variables
# ========================================================

# Base URL for the frontend application (used for shareable links & QR codes).
# In production (e.g. Vercel), set this to your deployed domain:
# VITE_CLIENT_URL=https://your-peershare-app.vercel.app
# If omitted, it automatically falls back to window.location.origin.
VITE_CLIENT_URL=http://localhost:5173

# Signaling server URL (Socket.IO backend).
# In production (e.g. Render/Railway), set this to your deployed backend URL:
# VITE_SOCKET_URL=https://your-peershare-server.onrender.com
VITE_SOCKET_URL=http://localhost:3000
